package negocio;

import java.util.List;

import integracion.DAOSalas;
import integracion.DAOSalasImp;

public class SASuscripcionImp implements SASuscripcion{

	private static DAOSuscripciones suscripcionesDAO = null;

	//USADO PATRON SINGLETON
	public static DAOSuscripcion getDAOSuscripciones(){
		if(salasDAO == null) salasDAO = new DAOSuscripcionesImp();
		return salasDAO;
	}

	public int altaSuscripcion(final DTOtSuscripcion suscripcion) {
		return getDAOSuscripciones().altaSuscripcion(suscripcion);
	}

	public DTOtSuscripcion leerSuscripcion(final int id) {
		return getDAOSuscripciones().leerSuscripcion(id);
	}

	public int actualizarSuscripcion(final DTOtSuscripcion suscripcion) {
		DTOtSuscripcion s = leerSuscripcion(suscripcion.getId());
		int exito = 0;
		if(s != null) exito = getDAOSuscripciones().actualizarSuscripcion(suscripcion);
		return exito;
	}

	public int borrar(final int id) {
		//TODO
	}

	public List<DTOtSala> leerTodasSalas() {
		return getDAOSuscripciones().leerTodasSalas();
	}

}
